APP_ENV=local
APP_DEBUG=false
APP_URL=https://social.example.com
APP_TIMEZONE=Asia/Dhaka
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_automation
DB_USER=social_user
DB_PASS=

# Set these only when Meta connection is configured.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# LinkedIn Developer app (Community Management API).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://social.example.com/index.php
LINKEDIN_API_VERSION=202608

# TikTok Developer app (Login Kit + Content Posting API).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://social.example.com/tiktok-callback.php

# Optional shared AI keys. A Page-specific key takes priority.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# Optional global comma-separated banned/sensitive words.
BANNED_WORDS=

# Generate a unique setup key; remove after initial setup.
SETUP_KEY=
